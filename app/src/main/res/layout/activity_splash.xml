<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:clipChildren="false">

        <View
            android:id="@+id/ring2"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring" />

        <View
            android:id="@+id/ring1"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring" />

        <View
            android:id="@+id/badgeGlow"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glow_circle" />

        <ImageView
            android:id="@+id/logoBadge"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge"
            android:contentDescription="@string/app_name"
            android:paddingLeft="34dp"
            android:paddingTop="34dp"
            android:paddingRight="34dp"
            android:paddingBottom="34dp"
            android:src="@drawable/ic_bolt" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSplashTitle"
            style="@style/GlassTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_title"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.12"
            android:text="@string/splash_tagline"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
