<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="26dp"
        android:paddingRight="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSnakeBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:text="@string/back"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSnakeScore"
                style="@style/GlassTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSnakeBest"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.jerrynifemi.brainblitz.SnakeView
            android:id="@+id/snakeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnUp"
                android:layout_width="66dp"
                android:layout_height="54dp"
                android:background="@drawable/glass_button_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▲"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLeft"
                    android:layout_width="66dp"
                    android:layout_height="54dp"
                    android:background="@drawable/glass_button_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnDown"
                    android:layout_width="66dp"
                    android:layout_height="54dp"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/glass_button_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/btnRight"
                    android:layout_width="66dp"
                    android:layout_height="54dp"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/glass_button_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/snakeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3060310"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="26dp"
            android:background="@drawable/glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="28dp"
            android:paddingRight="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvSnakeOverlayTitle"
                style="@style/GlassTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvSnakeOverlayDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSnakeAgain"
                style="@style/PrimaryButton"
                android:layout_marginTop="22dp"
                android:text="@string/play_again" />

            <TextView
                android:id="@+id/btnSnakeHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_button_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="@string/back_home"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
