<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="26dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBfBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:text="@string/back"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBfScore"
                style="@style/GlassTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvBfLines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_pill"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBfLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:background="@drawable/glass_pill"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/accent_alt"
                android:textSize="11sp" />
        </LinearLayout>

        <com.jerrynifemi.brainblitz.BlockfallView
            android:id="@+id/blockView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBfLeft"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="◀"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnBfRotate"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⟳"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnBfRight"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnBfDrop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/glass_button_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▼"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bfOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3060310"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="26dp"
            android:background="@drawable/glass_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="28dp"
            android:paddingRight="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvBfOverlayTitle"
                style="@style/GlassTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvBfOverlayDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnBfAgain"
                style="@style/PrimaryButton"
                android:layout_marginTop="22dp"
                android:text="@string/play_again" />

            <TextView
                android:id="@+id/btnBfHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_button_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:text="@string/back_home"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
